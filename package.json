{
  "name": "dsh-evolve-fusion2",
  "version": "0.2.0",
  "description": "Fusion2: Fusion + rule-based provenance (trace/breakthrough) preferred in fuse. Independent fork of Fusion; does not modify the Fusion repo.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "ORIGIN.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "example:mock": "node examples/mock-evolve-run.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.2.0",
    "dsh-evolve-loop": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "dsh-evolve-loop": { "optional": true }
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ddddwrrert/Fusion2.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "evolve",
    "fusion",
    "provenance",
    "trace",
    "organon"
  ]
}
